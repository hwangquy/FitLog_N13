{
  "expo": {
    "name": "FitLog",
    "slug": "fitlog-mobile",
    "scheme": "fitlog",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "expo-router",
        {
          "root": "frontend/app"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cho phép FitLog ghi nhận vị trí buổi tập khi bạn đồng ý."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép FitLog chọn ảnh buổi tập khi bạn đồng ý.",
          "cameraPermission": "Cho phép FitLog chụp ảnh buổi tập khi bạn đồng ý.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "workout-reminders"
        }
      ],
      "expo-font",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "android": {
      "package": "vn.fitlog.mobile",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "ios": {
      "bundleIdentifier": "vn.fitlog.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1806efad-ea27-4229-877f-542a40b36467"
      }
    }
  }
}
